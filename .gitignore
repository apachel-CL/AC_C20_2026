# Configuración local de Claude Code
.claude/settings.local.json

# Archivos del sistema y temporales de Office
Thumbs.db
desktop.ini
~$*
*.tmp

# Editor (se comparte solo settings.json si existe)
.vscode/*
!.vscode/settings.json

# Credenciales y secretos
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*credentials*
*secret*

# Evidencias: pueden contener IPs, MAC y usuarios (repo público)
# Anclado a la raíz para no ignorar las evidencias ficticias de scripts/tests/fixtures/
/evidencias/*
!/evidencias/.gitkeep
